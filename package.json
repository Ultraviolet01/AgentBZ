{
  "name": "agentbazaar",
  "private": true,
  "scripts": {
    "build": "turbo build --filter !extension",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:push": "pnpm --filter database push",
    "db:generate": "pnpm --filter database generate",
    "postinstall": "pnpm db:generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "turbo": "latest",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "axios": "^1.15.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "x402-axios": "1.2.0"
  }
}
