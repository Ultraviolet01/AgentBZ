# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentbazaar?schema=public"

# Auth
PORT=3001
JWT_SECRET=""
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LLM (for agent AI logic + orchestrator)
ANTHROPIC_API_KEY="your-anthropic-key"

# Hedera Testnet (get account at https://portal.hedera.com)
# Fund with testnet HBAR at https://portal.hedera.com/faucet
HEDERA_ACCOUNT_ID="0.0.XXXXXX"
HEDERA_PRIVATE_KEY="0xYourHederaPrivateKeyECDSA"
HEDERA_NETWORK="testnet"

# Demo buyer account — server signs x402 payments on behalf of users
# This is a SEPARATE account from the platform account
# Fund with testnet HBAR at: https://portal.hedera.com/faucet
HEDERA_DEMO_BUYER_ACCOUNT_ID="0.0.XXXXXX"
HEDERA_DEMO_BUYER_PRIVATE_KEY="0xYourDemoBuyerPrivateKey"

# Blocky402 Facilitator (Hedera testnet — no API key required)
# From Blocky402 quickstart docs
BLOCKY402_URL="https://api.testnet.blocky402.com"
NEXT_PUBLIC_BLOCKY402_URL="https://api.testnet.blocky402.com"

# AgentBazaar payout account (where buyers pay to)
# Same as HEDERA_ACCOUNT_ID for now
AGENTBAZAAR_PAY_TO="0.0.XXXXXX"

# HCS Topic ID (created in Stage 3)
HEDERA_HCS_TOPIC_ID=""

# Story Protocol CDR (server-side only)
AGENTBAZAAR_PLATFORM_KEY="0x_your_platform_private_key"
STORY_RPC="https://aeneid.storyrpc.io"
CDR_WRITE_CONDITION="0x4C9bFC96d7092b590D497A191826C3dA2277c34B"
CDR_READ_CONDITION="0xC0640AD4CF2CaA9914C8e5C44234359a9102f7a3"
